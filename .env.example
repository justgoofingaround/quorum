# Voices: "mock" (no network, grounded script) or "nicrron"
QUORUM_PROVIDER=mock
# Nicrron, assumed OpenAI-compatible /chat/completions; check the Discord setup guide
NICRRON_BASE_URL=
NICRRON_API_KEY=
NICRRON_MODEL=
# PRISM by Block Convey (Developers > API keys / SDK setup)
PRISMTRACE_API_KEY=
PRISM_PROJECT_ID=
# Seconds between turns in mock mode
QUORUM_TURN_DELAY=0.9
